FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY . /app
RUN python -m pip install --no-cache-dir ".[gateway]" \
    && groupadd --system openworkgraph \
    && useradd --system --gid openworkgraph --home-dir /nonexistent --shell /usr/sbin/nologin openworkgraph \
    && chown -R openworkgraph:openworkgraph /app

USER openworkgraph

EXPOSE 8790
CMD ["python", "-m", "uvicorn", "gateway.enterprise_app:app", "--host", "0.0.0.0", "--port", "8790"]
