# Example only. Replace every placeholder before enabling the unit.
# Keep this environment file root-owned, mode 0600. It is not a shell script.
# Use a dedicated prepared workspace and canonical POSIX paths per instance.
WORKFLOW_OBSERVER_DATA=/var/lib/openworkgraph-connectors/INSTANCE/workspace
WORKFLOW_OBSERVER_AUTH_DIR=/var/lib/openworkgraph-connectors/INSTANCE/auth
WORKFLOW_OBSERVER_CONFIG=/var/lib/openworkgraph-connectors/INSTANCE/config.json
OWG_CONNECTOR_OUTBOX=/var/lib/openworkgraph-connectors/INSTANCE/outbox
OWG_CONNECTOR_SECRET_ROOT=/var/lib/openworkgraph-connectors/INSTANCE/secrets
OWG_CONNECTOR_SECRET_FILES={"OWG_CONNECTOR_WORKER_TOKEN":"gateway.token","OWG_REST_TOKEN_PRODUCTION":"source.token"}
OWG_CONNECTOR_GATEWAY_URL=https://gateway.example.invalid
OWG_CONNECTOR_ORGANIZATION=REPLACE_ORGANIZATION
OWG_CONNECTOR_JOB_ID=REPLACE_JOB_ID
OWG_CONNECTOR_PROFILE_ID=REPLACE_PROFILE_ID
OWG_CONNECTOR_PROFILE_REVISION=REPLACE_REVISION
OWG_CONNECTOR_PROFILE_SHA256=REPLACE_DIGEST
OWG_REST_ALLOWED_ENDPOINTS=["https://provider.example.invalid/events"]
# Deliberately disabled until the administrator has reviewed the exact pin.
OWG_CONNECTOR_WORKER_APPROVED=false
