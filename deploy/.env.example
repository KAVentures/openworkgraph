# Generate each secret independently. Example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_PASSWORD=replace-with-a-long-random-secret
OWG_GATEWAY_ADMIN_TOKEN=replace-with-a-different-long-random-secret
OWG_GATEWAY_ENROLLMENT_TOKEN=replace-with-another-long-random-secret

# Safe default: Gateway is reachable only from this host. Set 0.0.0.0 only when
# deliberately placing it behind customer-controlled TLS/network access controls.
OWG_GATEWAY_BIND_ADDRESS=127.0.0.1
OWG_GATEWAY_PORT=8790

# Recommended for the self-hosted PostgreSQL Gateway. Existing deployments that
# omit these variables keep the old direct-connection behavior (pool max = 0).
OWG_GATEWAY_DB_POOL_MIN_SIZE=1
OWG_GATEWAY_DB_POOL_MAX_SIZE=10
OWG_GATEWAY_DB_POOL_TIMEOUT_SECONDS=10

# In-process credential rate limits. Set any value to 0 to disable that bucket.
# Multi-replica production deployments should ALSO enforce aggregate limits at
# the customer-controlled reverse proxy / load balancer.
OWG_GATEWAY_PRINCIPAL_RATE_LIMIT_PER_MINUTE=600
OWG_GATEWAY_ADMIN_RATE_LIMIT_PER_MINUTE=120
OWG_GATEWAY_ENROLLMENT_RATE_LIMIT_PER_MINUTE=60

# Optional human OIDC/SSO. Leave issuer/audience/JWKS blank to keep human SSO
# disabled; service/device tokens continue working exactly as before.
OWG_GATEWAY_OIDC_ISSUER=
OWG_GATEWAY_OIDC_AUDIENCE=
OWG_GATEWAY_OIDC_JWKS_URL=
OWG_GATEWAY_OIDC_ORGANIZATION_CLAIM=owg_org
OWG_GATEWAY_OIDC_ACTOR_CLAIM=sub
OWG_GATEWAY_OIDC_GROUPS_CLAIM=groups
OWG_GATEWAY_OIDC_SELF_READ=true

# JSON map from IdP group -> explicit OpenWorkGraph human scopes. Examples:
# {"Engineering Managers":["team:engineering:evidence:read"],"Process Analysts":["aggregate:read"]}
OWG_GATEWAY_OIDC_GROUP_SCOPE_MAP={}

# Aggregate-only reads never return actor IDs and suppress patterns unless at
# least this many distinct actors contributed. The server minimum cannot be
# lowered by the caller. Values below 3 are rejected; 5+ is recommended.
OWG_GATEWAY_AGGREGATE_MIN_ACTORS=5

# Required only if any mapped group receives pseudonymous:evidence:read.
# Use a stable random secret >=32 characters; rotation intentionally changes all
# pseudonyms. Pseudonymization is NOT anonymization.
OWG_GATEWAY_PSEUDONYM_KEY=
