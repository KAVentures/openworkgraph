{
  "manifest_version": 3,
  "name": "OpenWorkGraph Browser Sensor",
  "version": "1.16.0",
  "version_name": "1.16.0-opt-in-work-text",
  "description": "Local-first structural browser telemetry. Optional work text capture requires a separate explicit local privacy setting; sensitive fields and sites are excluded. No Gateway text sync.",
  "incognito": "not_allowed",
  "permissions": [
    "tabs",
    "webNavigation",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "browser_auth.js",
      "background.js",
      "workflow_enrichment.js",
      "browser_signal_enrichment.js",
      "resource_reference_parser.js",
      "resource_reference_enrichment.js"
    ],
    "service_worker": "secure_background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js",
        "content_enrichment.js",
        "browser_signals.js",
        "agent_surface_adapters.js",
        "work_text_capture.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Workflow Observer Browser Sensor",
    "default_popup": "popup.html"
  }
}
